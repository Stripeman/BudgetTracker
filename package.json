{
  "name": "budget-tracker",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Privacy-first budgeting service with accounts, debt tracking, forecasting, trip planning, shared expenses, and multiple currencies.",
  "scripts": {
    "test": "npm run test:repo && npm run test:api && npm run test:app",
    "test:repo": "node --test --test-concurrency=1 test/*.test.cjs scripts/deploy/test/*.test.mjs",
    "test:api": "npm --prefix api test",
    "test:app": "node --test --test-concurrency=1 app/test/*.test.js",
    "dev": "node scripts/dev/server.mjs",
    "seed:dev": "node scripts/dev/seed.mjs",
    "e2e": "node scripts/dev/e2e/run.mjs",
    "validate": "node scripts/validate.cjs",
    "generate:functions": "node scripts/generate-functions.cjs",
    "build": "npm test && npm run validate",
    "build:artifact": "node scripts/build-artifact.mjs",
    "vendor:tiptap": "node scripts/vendor-tiptap.mjs"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.10",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "esbuild": "0.28.2"
  }
}
